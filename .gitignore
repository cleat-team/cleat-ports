# scripts/install-cleat.sh clones cleat here. Anchored patterns like /.venv/ do
# not cover it, and an unignored full checkout of another repo inside this one
# makes `git status` useless after the first local run.
/.cleat-src/
/bin/
/out/
/.port-results/

# Ports create these in their own directories, so these must not be anchored.
.venv/
__pycache__/
*.pyc
*.wasm
.pytest_cache/
node_modules/

# coverage artefacts from `make test CLEAT_PORTS_COVERAGE=1`, which the nightly
# sets so scripts/check-assertions-executed.py has data to read. Both are
# per-run and neither is meaningful outside the run that produced them.
.coverage
.coverage.*
junit.xml
