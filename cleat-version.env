# The cleat version this repo's ports are known to pass against.
#
# Pull-request CI runs against CLEAT_PINNED_REF. Nightly CI runs against
# CLEAT_DEV_REF and reports failures to the core repo as a tracking issue.
#
# Bump CLEAT_PINNED_REF only in a PR that also makes the ports pass against it,
# so that `git log cleat-version.env` reads as a history of which cleat versions
# this suite has actually validated.

CLEAT_PINNED_REF=v0.2.0
CLEAT_DEV_REF=develop
CLEAT_REPO=github.com/cleat-team/cleat
